{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Selection Text Reader",
  "description": "Read selected text aloud in its original language or translate and read it.",
  "version": "2.3.1",
  "permissions": [
    "activeTab",
    "contextMenus",
    "offscreen",
    "scripting",
    "storage",
    "tts"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://tessdata.projectnaptha.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src https://translate.googleapis.com https://tessdata.projectnaptha.com data: blob:; img-src 'self' data: blob:"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Selection Text Reader",
    "default_popup": "popup.html"
  },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read selected text"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume reading"
    },
    "stop-reading": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop reading"
    }
  },
  "options_page": "options.html"
}
